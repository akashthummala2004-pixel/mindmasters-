# Resend (https://resend.com) — required for the inquiry form's email send.
# Sign up, create an API key, paste it here, then restart `npm run dev`.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where inquiries are delivered. Defaults to mmaisolutions.pvt@gmail.com if unset.
INQUIRY_TO_EMAIL=mmaisolutions.pvt@gmail.com

# The "From" address shown on inquiry emails.
# - For testing: leave the default ("Mind Masters <onboarding@resend.dev>") — Resend's sandbox sender works without domain setup but ONLY delivers to the email you signed up with.
# - For production: verify your sending domain in Resend, then use something like:
#   INQUIRY_FROM_EMAIL=Mind Masters <hello@yourdomain.com>
INQUIRY_FROM_EMAIL=Mind Masters <onboarding@resend.dev>
